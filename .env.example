# github | local | azure, or a list such as github,azure for both hosts at once
FUDA_HOSTS=github

# github: log in with a GitHub App (see CONTRIBUTING.md). Needs only the client id.
FUDA_GITHUB_CLIENT_ID=
# The App slug (github.com/apps/<slug>). Required with github: fuda links people to its install page.
FUDA_GITHUB_APP_SLUG=
# Optional: more repositories to list as Boards, next to the fuda- ones (owner/repo, comma-separated).
# FUDA_GITHUB_BOARDS=acme/activity-tracker

# FUDA_HOSTS=local
# FUDA_LOCAL_PATH=../../safesleep/platform
# FUDA_TITLE=safesleep

# FUDA_HOSTS=azure
# azure: log in with a Microsoft Entra ID app (see CONTRIBUTING.md). Also needs FUDA_BASE_URL and FUDA_COOKIE_SECRET (at least 32 characters).
# FUDA_BASE_URL=http://localhost:5173
# FUDA_COOKIE_SECRET=change-me-to-a-long-random-string
# FUDA_AZURE_CLIENT_ID=
# FUDA_AZURE_CLIENT_SECRET=
# FUDA_AZURE_TENANT=organizations
# Optional: more repositories to list as Boards, next to the fuda- ones (org/project/repo, comma-separated).
# FUDA_AZURE_BOARDS=acme/Team/activity-tracker

FUDA_WATCH_MAIN=false
FUDA_SYNC_COOLDOWN=30s
FUDA_CACHE_DIR=.fuda-cache
